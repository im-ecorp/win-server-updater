<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Lets the same executable run on the .NET 4.x runtime (Windows Server 2012 and newer)
    and on the .NET 2.0/3.5 runtime (Windows Server 2008 / 2008 R2).
    Keep this file next to WinUpdateManager.exe.
  -->
  <startup>
    <supportedRuntime version="v4.0" />
    <supportedRuntime version="v2.0.50727" />
  </startup>
</configuration>
